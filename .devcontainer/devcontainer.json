{
  "name": "K8s Observability GitOps",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 5601, 8080, 9090, 9093],
  "portsAttributes": {
    "3000": {"label": "Grafana"},
    "5601": {"label": "Kibana"},
    "8080": {"label": "Argo CD"},
    "9090": {"label": "Prometheus"},
    "9093": {"label": "Alertmanager"}
  },
  "postCreateCommand": "bash scripts/setup-tools.sh"
}
